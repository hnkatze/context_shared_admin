# Every value here is a PLACEHOLDER. Copy to .env and fill it in locally.
# Never commit a real credential to this file.

# Supabase pooler in TRANSACTION mode (port 6543) — never the direct connection (5432).
# The panel opens one connection per serverless instance; a direct connection exhausts
# Postgres. Connect as the mcp_app application role: the postgres and service_role roles
# carry BYPASSRLS, which turns every tenancy policy into decoration.
# The pooler username is the role name, a dot, then the project ref.
CONTEXT_SHARED_DATABASE_URL=postgresql://mcp_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The single organization this deployment administers. A wrong id does not fail: RLS
# returns nothing and the panel renders healthy while pointed at an empty org, so it is
# checked against the organizations table at first use.
PANEL_ORG_ID=00000000-0000-0000-0000-000000000000

# scrypt:N:r:p:salt:key — generate with: node scripts/hash-password.mjs '<password>'
# Store the hash, never the password. Colon-separated on purpose: Vite expands `$1`/`$8`
# in this file, so a `$`-separated hash arrives truncated and the panel refuses to start.
PANEL_PASSWORD_HASH=scrypt:16384:8:1:REPLACE_SALT_BASE64:REPLACE_KEY_BASE64

# HMAC key for the session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every open session out.
PANEL_SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
