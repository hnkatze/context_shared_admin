---
import Layout from '../layouts/Layout.astro';
import { panelOrgId, withTenant } from '../lib/db';

type CardRow = {
  card_key: string;
  module: string;
  summary: string;
  tags: string[] | null;
  author: string;
  updated_at: Date;
  project_name: string;
};

type ProjectRow = { slug: string; name: string; card_count: string };

type CardView = {
  readonly cardKey: string;
  readonly module: string;
  readonly summary: string;
  readonly tags: readonly string[];
  readonly author: string;
  readonly updatedIso: string;
  readonly updatedLabel: string;
  readonly projectName: string;
};

type ChipView = {
  readonly label: string;
  readonly count: string;
  readonly href: string;
  readonly active: boolean;
};

const RELATIVE = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
const UNITS: readonly (readonly [Intl.RelativeTimeFormatUnit, number])[] = [
  ['year', 31_536_000],
  ['month', 2_592_000],
  ['week', 604_800],
  ['day', 86_400],
  ['hour', 3_600],
  ['minute', 60],
];

function relativeTime(moment: Date, now: number): string {
  const seconds = Math.round((now - moment.getTime()) / 1000);
  for (const [unit, size] of UNITS) {
    if (Math.abs(seconds) >= size) return RELATIVE.format(-Math.round(seconds / size), unit);
  }
  return RELATIVE.format(-seconds, 'second');
}

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const projectFilter = (Astro.url.searchParams.get('project') ?? '').trim();

/** Every chip and the search field carry the other's state, so filtering never drops the query. */
function boardHref(slug: string | null, term: string): string {
  const params = new URLSearchParams();
  if (term !== '') params.set('q', term);
  if (slug !== null) params.set('project', slug);
  const search = params.toString();
  return search === '' ? '/' : `/?${search}`;
}

let cards: CardRow[] = [];
let projects: ProjectRow[] = [];
let lastPublish: Date | null = null;
let failure: string | null = null;

try {
  const orgId = await panelOrgId();
  const board = await withTenant(orgId, async (client) => {
    // A null $1 makes the first OR branch true, which is how "no query" lists everything
    // without ever splicing the search term into the statement.
    const cardResult = await client.query<CardRow>(
      `select c.card_key, c.module, c.summary, c.tags, c.author, c.updated_at,
              p.name as project_name
         from cards c
         join projects p on p.id = c.project_id
        where ($1::text is null or c.search_vector @@ plainto_tsquery('simple', $1))
          and ($2::text is null or p.slug = $2)
        order by c.updated_at desc
        limit 50`,
      [query === '' ? null : query, projectFilter === '' ? null : projectFilter],
    );
    // Counted under the query but not under the project filter: the chips have to say
    // where the matches are, including in the project you are not looking at.
    const projectResult = await client.query<ProjectRow>(
      `select p.slug, p.name, count(c.id)::text as card_count
         from projects p
         left join cards c
           on c.project_id = p.id
          and ($1::text is null or c.search_vector @@ plainto_tsquery('simple', $1))
        group by p.slug, p.name
        order by p.slug`,
      [query === '' ? null : query],
    );
    const publishResult = await client.query<{ last_publish: Date | null }>(
      'select max(updated_at) as last_publish from cards',
    );
    return {
      cards: cardResult.rows,
      projects: projectResult.rows,
      lastPublish: publishResult.rows[0]?.last_publish ?? null,
    };
  });
  cards = board.cards;
  projects = board.projects;
  lastPublish = board.lastPublish;
} catch (error) {
  failure = error instanceof Error ? error.message : String(error);
}

const now = Date.now();

const cardViews: readonly CardView[] = cards.map((card) => ({
  cardKey: card.card_key,
  module: card.module,
  summary: card.summary,
  tags: card.tags ?? [],
  author: card.author,
  updatedIso: card.updated_at.toISOString(),
  updatedLabel: card.updated_at.toISOString().slice(0, 10),
  projectName: card.project_name,
}));

const matchTotal = projects.reduce((total, project) => total + Number(project.card_count), 0);

const chips: readonly ChipView[] = [
  {
    label: 'All projects',
    count: String(matchTotal),
    href: boardHref(null, query),
    active: projectFilter === '',
  },
  ...projects.map((project) => ({
    label: project.name,
    count: project.card_count,
    href: boardHref(project.slug, query),
    active: project.slug === projectFilter,
  })),
];

const lastPublishLabel = lastPublish === null ? 'nothing published yet' : relativeTime(lastPublish, now);
---

<Layout title="Board">
  <main id="main" class="anim-view shell" style="padding-block:var(--space-8)">
    <header
      style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-4)"
    >
      <div style="max-width:620px">
        <p class="eyebrow">Shared context</p>
        <h1 class="display">The board</h1>
        <p style="margin:var(--space-2) 0 0;font-size:17px;color:var(--color-neutral-800)">
          What the agents could not have inferred from the code.
        </p>
      </div>

      <div style="text-align:right;font-size:12px;color:var(--color-neutral-600)">
        <p style="margin:0">
          last publish {lastPublish === null ? (
            lastPublishLabel
          ) : (
            <time datetime={lastPublish.toISOString()}>{lastPublishLabel}</time>
          )}
        </p>
        <p style="margin:0" class="mono">MCP writes · panel curates</p>
      </div>
    </header>

    <hr class="hr" />

    {failure !== null && (
      <section
        role="alert"
        style="border-left:3px solid var(--color-accent-2);background:var(--color-surface);padding:var(--space-3) var(--space-4);border-radius:var(--radius-md)"
      >
        <h2 style="font-size:17px;margin:0 0 var(--space-1)">Could not reach the board</h2>
        <p class="mono" style="margin:0;font-size:12px;overflow-wrap:anywhere">{failure}</p>
      </section>
    )}

    {failure === null && (
      <>
        <form method="GET" action="/" role="search" style="max-width:560px">
          <div class="field" style="margin-bottom:var(--space-2)">
            <label for="q">Search the board</label>
            <input
              id="q"
              class="input"
              type="search"
              name="q"
              value={query}
              placeholder="retry, idempotency, webhook…"
              autocomplete="off"
            />
          </div>
          {projectFilter !== '' && <input type="hidden" name="project" value={projectFilter} />}
          <button type="submit" class="btn btn-primary">Search</button>
          {query !== '' && (
            <a href={boardHref(projectFilter === '' ? null : projectFilter, '')} class="btn btn-ghost">
              Clear
            </a>
          )}
        </form>

        <nav
          aria-label="Filter by project"
          style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-4)"
        >
          {chips.map((chip) => (
            <a
              href={chip.href}
              aria-current={chip.active ? 'page' : undefined}
              class={chip.active ? 'tag tag-accent' : 'tag tag-outline'}
              style={`text-decoration:none;gap:6px;${chip.active ? 'font-weight:600;box-shadow:inset 0 0 0 1px var(--color-accent-600)' : ''}`}
            >
              {chip.active && <span aria-hidden="true">✓</span>}
              <span>{chip.label}</span>
              <span class="mono" style="opacity:.7">{chip.count}</span>
            </a>
          ))}
        </nav>

        <section aria-labelledby="cards-heading" style="margin-top:var(--space-6)">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-3)">
            <h2 id="cards-heading" class="eyebrow" style="font-family:var(--font-body);margin-bottom:var(--space-2)">
              Cards
            </h2>
            <p class="eyebrow" style="font-family:var(--font-body);margin-bottom:var(--space-2)">
              {cardViews.length} shown
            </p>
          </div>

          {cardViews.length === 0 ? (
            <p style="margin:var(--space-4) 0 0;color:var(--color-neutral-700)">
              {query === '' ? (
                'Nothing published yet.'
              ) : (
                <>Nothing matches <span class="mono">{query}</span>.</>
              )}
            </p>
          ) : (
            <ul style="list-style:none;margin:0;padding:0;border-top:1px solid var(--color-divider)">
              {cardViews.map((card) => (
                <li
                  style="display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:var(--space-4);padding:var(--space-3) 0;border-bottom:1px solid var(--color-divider)"
                >
                  <div style="flex:1 1 480px;min-width:0">
                    <p class="mono" style="margin:0;font-size:13px;color:var(--color-neutral-700)">
                      <span style="color:var(--color-text)">{card.cardKey}</span>
                      <span aria-hidden="true" style="padding:0 6px">/</span>
                      <span>{card.module}</span>
                    </p>
                    <p style="margin:var(--space-1) 0 0;font-size:17px;line-height:1.35;max-width:72ch">
                      {card.summary}
                    </p>
                    {card.tags.length > 0 && (
                      <ul
                        aria-label="Tags"
                        style="list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-1);margin:var(--space-2) 0 0;padding:0"
                      >
                        {card.tags.map((tag) => (
                          <li class="tag tag-outline">{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>

                  <div
                    style="flex:0 0 auto;text-align:right;font-size:12px;color:var(--color-neutral-600)"
                  >
                    <p style="margin:0;color:var(--color-text)">{card.projectName}</p>
                    <p style="margin:0">
                      updated <time datetime={card.updatedIso}>{card.updatedLabel}</time>
                    </p>
                    <p style="margin:0">{card.author}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )}
  </main>
</Layout>
