---
import Layout from '../layouts/Layout.astro';
import {
  SESSION_COOKIE,
  allowLoginAttempt,
  isSessionValid,
  issueSession,
  verifyPassword,
} from '../lib/auth';

const REDIRECT_BASE = 'http://internal.invalid';

/**
 * Resolving against a throwaway origin is what rejects `//host`, `/\host` and a tab or
 * newline smuggled into the path; a startsWith check lets all three through, and browsers
 * read `/\host` as an absolute URL.
 */
function safeNext(raw: string | null): string {
  if (raw === null || !raw.startsWith('/')) return '/';
  let resolved: URL;
  try {
    resolved = new URL(raw, REDIRECT_BASE);
  } catch {
    return '/';
  }
  if (resolved.origin !== REDIRECT_BASE) return '/';
  // An origin check alone is not enough: `//host` smuggled into the PATH survives it, and
  // the browser resolves that Location protocol-relative against the real origin.
  if (resolved.pathname.startsWith('//')) return '/';
  // Bouncing back here would loop against the already-signed-in redirect below.
  if (resolved.pathname.toLowerCase().replace(/\/$/, '') === '/login') return '/';
  return `${resolved.pathname}${resolved.search}`;
}

/** The adapter throws instead of returning undefined when it cannot supply an address. */
function clientKey(): string {
  try {
    return Astro.clientAddress;
  } catch {
    return 'unknown';
  }
}

type Outcome = 'wrong-password' | 'rate-limited' | 'misconfigured';

const MESSAGES: Record<Outcome, string> = {
  // Deliberately identical wording for a wrong password and an empty field: the form
  // must not tell an attacker which half of the guess was right.
  'wrong-password': 'Incorrect password.',
  'rate-limited': 'Too many attempts. Wait a few minutes and try again.',
  'misconfigured': 'The panel is missing its login configuration. Check the server environment.',
};

let outcome: Outcome | null = null;
const next = safeNext(Astro.url.searchParams.get('next'));

if (isSessionValid(Astro.cookies.get(SESSION_COOKIE)?.value)) {
  return Astro.redirect(next, 303);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submitted = form.get('password');
  const password = typeof submitted === 'string' ? submitted : '';
  const submittedNext = form.get('next');
  const target = safeNext(typeof submittedNext === 'string' ? submittedNext : next);

  if (!allowLoginAttempt(clientKey())) {
    outcome = 'rate-limited';
  } else {
    try {
      if (verifyPassword(password)) {
        const session = issueSession();
        Astro.cookies.set(SESSION_COOKIE, session.value, {
          httpOnly: true,
          secure: import.meta.env.PROD,
          sameSite: 'lax',
          path: '/',
          maxAge: session.maxAge,
        });
        return Astro.redirect(target, 303);
      }
      outcome = 'wrong-password';
    } catch {
      outcome = 'misconfigured';
    }
  }
}

if (outcome !== null) Astro.response.status = outcome === 'rate-limited' ? 429 : 401;
---

<Layout title="Sign in" chrome={false}>
  <main
    id="main"
    style="display:flex;flex-wrap:wrap;align-items:stretch;min-height:100dvh"
  >
    <section
      aria-labelledby="masthead"
      style="flex:1.3 1 30rem;display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-8);padding:clamp(var(--space-6),5vw,calc(var(--space-8) * 1.6));background:var(--color-bg)"
    >
      <div class="anim-view">
        <p class="eyebrow" style="color:var(--color-neutral-700);margin-bottom:var(--space-4)">
          context_shared &middot; admin edition
        </p>

        <h1
          id="masthead"
          class="display"
          style="font-size:clamp(44px, 7vw, 76px);letter-spacing:-0.03em"
        >
          Boardroom
        </h1>

        <hr class="hr" style="margin:var(--space-6) 0" />

        <p
          style="margin:0;max-width:22ch;font-family:var(--font-heading);font-size:25px;line-height:1.24;border-left:2px solid var(--color-accent-2);padding-left:var(--space-3)"
        >
          This panel issues and revokes the API keys for the whole board.
        </p>

        <p
          style="margin:var(--space-4) 0 0;max-width:48ch;font-size:14px;color:var(--color-neutral-700)"
        >
          Agents publish the non-obvious logic a reader could not have inferred from the
          code, and every one of them arrives holding a key that was minted &mdash; or
          revoked &mdash; on this side of the door.
        </p>
      </div>

      <div style="display:flex;align-items:flex-start;gap:var(--space-4)">
        <span
          class="cmyk-num"
          aria-hidden="true"
          style="flex:none;font-family:var(--font-heading);font-weight:var(--font-heading-weight);font-size:64px"
        >
          <span class="paper">01</span>
          <span class="plate plate-c">01</span>
          <span class="plate plate-m">01</span>
          <span class="plate plate-y">01</span>
        </span>

        <div style="max-width:34ch">
          <p class="eyebrow" style="color:var(--color-neutral-700);margin-bottom:var(--space-1)">
            Plate 01 &middot; registration
          </p>
          <p style="margin:0;font-size:13px;color:var(--color-neutral-700)">
            On press, nothing prints until all three plates line up. The door works the
            same way.
          </p>
        </div>
      </div>
    </section>

    <section
      aria-labelledby="signin-heading"
      style="flex:1 1 24rem;display:flex;flex-direction:column;justify-content:center;padding:clamp(var(--space-6),5vw,calc(var(--space-8) * 1.6));background:var(--color-surface)"
    >
      <div class="anim-view" style="width:100%;max-width:40ch">
        <p style="margin:0 0 var(--space-3)">
          <span class="tag tag-accent-2">Restricted</span>
        </p>

        <h2 id="signin-heading" style="margin:0 0 var(--space-2)">Sign in</h2>

        <p style="margin:0 0 var(--space-6);font-size:14px;color:var(--color-neutral-700)">
          One shared password, no accounts. A session lasts twelve hours and then this
          door closes again.
        </p>

        <form method="POST">
          <input type="hidden" name="next" value={next} />

          {outcome !== null && (
            <p
              id="login-error"
              role="alert"
              style="display:flex;gap:var(--space-2);margin:0 0 var(--space-4);padding:var(--space-2) var(--space-3);font-size:13px;color:var(--color-accent-2-800);background:var(--color-accent-2-100);border-left:2px solid var(--color-accent-2);border-radius:var(--radius-sm)"
            >
              <span aria-hidden="true" class="mono" style="font-weight:600">!</span>
              {MESSAGES[outcome]}
            </p>
          )}

          <div class="field">
            <label for="password">Admin password</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              autofocus
              aria-describedby={outcome !== null ? 'login-error' : undefined}
              aria-invalid={outcome === 'wrong-password' ? 'true' : undefined}
              class="input"
              style="min-height:calc(var(--space-8) + var(--space-1));font-size:15px;padding-inline:var(--space-2)"
            />
          </div>

          <button
            type="submit"
            class="btn btn-primary btn-block"
            style="margin-top:var(--space-4);min-height:calc(var(--space-8) + var(--space-1));font-size:20px;font-weight:600;letter-spacing:-0.01em"
          >
            Sign in
          </button>
        </form>

        <p
          class="mono"
          style="margin:var(--space-6) 0 0;font-size:12px;color:var(--color-neutral-700)"
        >
          no recovery &middot; attempts are rate limited
        </p>
      </div>
    </section>
  </main>
</Layout>
